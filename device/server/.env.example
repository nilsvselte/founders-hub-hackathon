# Devices and the marketplace room each one sits in: device_id:room_id, comma separated.
DEVICES=dev-1:digs-demo-1

# Shared bearer token the boards send. Leave empty to accept telemetry without a token.
DEVICE_TOKEN=

# Marketplace push target. Leave MARKETPLACE_URL empty to store events without sending them.
MARKETPLACE_URL=http://127.0.0.1:8000
MARKETPLACE_DEVICE_TOKEN=

# SQLite file, relative to device/server.
DATABASE_PATH=device.db

# Occupancy tuning (see app/occupancy.py).
# A ToF zone counts as a person when it is this many mm closer than the empty baseline.
PRESENCE_DELTA_MM=250
# Without a baseline, a zone closer than this counts as a person.
PRESENCE_NEAR_MM=1200
# Zones that must agree before a frame counts as "someone is there".
PRESENCE_MIN_ZONES=3
# Consecutive present frames before the room turns occupied.
OCCUPIED_AFTER_FRAMES=2
# Seconds without a present frame before the room turns empty.
EMPTY_AFTER_SECONDS=30
# A device is offline when it has not reported for this many seconds.
OFFLINE_AFTER_SECONDS=30

# Timezone for timestamps in API responses.
TIMEZONE=Europe/Oslo
