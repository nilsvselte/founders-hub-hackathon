DATABASE_URL=postgresql://marketplace:marketplace@127.0.0.1:5432/marketplace
# Enable for HTTPS deployments.
# MARKETPLACE_SECURE_COOKIES=1

# Local demo controls and fallback matching. Leave disabled on shared deployments.
MARKETPLACE_DEMO_MODE=0

# Venue metadata and default demo room: digs, kowork, or brighten.
MARKETPLACE_VENUE=digs

# Set the key to enable live Claude matching. Leave it unset for the keyless demo.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional when your organization key requires a workspace.
# ANTHROPIC_WORKSPACE_ID=

# Select a device adapter by factory path, e.g. app.vendor_device:create_adapter.
MARKETPLACE_DEVICE_ADAPTER=atech
# MARKETPLACE_DEVICE_TOKEN=
# MARKETPLACE_TURNAROUND_MINUTES=2

# Web push notifications. Generate a pair with the command in docs/notifications.md.
# Without keys the API runs and sends no pushes.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@standbyroom.com
